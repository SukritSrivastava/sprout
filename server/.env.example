# Copy this file to server/.env and fill in your own values. server/.env is git-ignored.
# Never paste these values into chat, docs, or client code.

# Your Google AI Studio key (https://aistudio.google.com/apikey). Leave empty to run the
# mentor in offline mode with prepared answers.
GEMINI_API_KEY=

# PayPal SANDBOX app keys (developer.paypal.com → Apps & Credentials → Sandbox → your app).
# Test money only: the server only ever talks to api-m.sandbox.paypal.com. Leave empty and the
# PayPal pages show how to add them. Tick "Payouts" in the app's features for guardian payouts.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Judge demo: no PIN gates. Set false and restart the API to restore protected mode.
DEMO_OPEN_ACCESS=true

# Protected-mode payouts: each adult approves with their own PIN (at least 6 characters; make them different).
# A payout needs two sample roles in demo mode. With protection enabled, all PINs must be set.
PAYOUT_PIN_MENTOR=
PAYOUT_PIN_ADMIN=
PAYOUT_PIN_GUARDIAN=
# The guardian's PayPal SANDBOX personal account email. Payouts always go here; the website
# can't change it.
GUARDIAN_PAYPAL_EMAIL=

# Where PayPal receipts, the reward pool and payout requests are saved (relative to server/).
# Never delete records to resolve an uncertain payout. Use disposable paths for tests.
DATA_FILE=data/paypal-records.json

# Gemini model name (agreed: gemini-3.5-flash-lite: fast and cheap, good for short answers).
GEMINI_MODEL=gemini-3.5-flash-lite

# Where the server listens. The website's dev server proxies /api here.
API_PORT=8787
HOST=127.0.0.1

# Website addresses allowed to use the mentor from a browser, comma-separated. Other websites
# get 403. When deployed, set this to your real website address, e.g. https://sprout.vercel.app
ALLOWED_ORIGIN=http://127.0.0.1:5173,http://127.0.0.1:4173,http://localhost:5173,http://localhost:4173

# Keep false locally. On Render set TRUST_PROXY=render in the service settings;
# only one private ingress hop is trusted. Generic true is reserved for another trusted proxy.
TRUST_PROXY=false

# Most mentor questions per hour from everyone together (protects your Gemini quota).
MENTOR_HOURLY_LIMIT=300

# The blockchain for the public impact ledger. Leave as is to use the local test chain that
# `npm run dev` starts (Hardhat, fake money, no wallet needed).
CHAIN_RPC_URL=http://127.0.0.1:8545

# Only for a real public chain later: a dedicated publisher wallet's key, typed in by hand.
# Leave empty locally. Never put a wallet that holds real money here.
PUBLISHER_PRIVATE_KEY=

# Protected guardian permission uses PAYOUT_PIN_GUARDIAN, even without PayPal keys or a payee email.
# With DEMO_OPEN_ACCESS=false, record permission at /soon/safety. Dev reloads saved settings;
# restart a production API after changing this file. Check with: npm run check:config -w server.
# Sample learning reviews, garden and permission live separately from PayPal money records.
LEARNING_DATA_FILE=data/learning-records.json

# Optional shared Postgres backend. Leave blank to preserve local file storage.
# Use the Supabase Session pooler URL (port 5432) from its Connect panel.
# Hosted connections require sslmode=verify-full. Keep the database password server-side.
# Run npm run db:migrate -w server explicitly before starting this backend.
# This seeds synthetic activities and an empty pool; it never imports local payment files.
DATABASE_URL=
# Supabase's server root certificate from Database Settings, as PEM text.
# Render supports a multiline value; a single line using literal \n also works.
# Certificate verification stays enabled. Do not use rejectUnauthorized=false.
DATABASE_SSL_CA=

# Shared ledger setup. 31337 is only for the local Hardhat test node. Use 84532 with an HTTPS
# Base Sepolia RPC and a dedicated test-only PUBLISHER_PRIVATE_KEY for the public test ledger.
# Run db:migrate first, then ledger:setup -- --deploy explicitly once. Its saved signed
# deployment is reused if a reply is lost. API startup never deploys a contract.
LEDGER_CHAIN_ID=31337
# Optional: bind an existing deployment instead of creating one; set BOTH public values.
LEDGER_CONTRACT_ADDRESS=
LEDGER_DEPLOY_TX=
