# Copy this file to server/.env and fill in your own values. server/.env is git-ignored.
# Never paste these values into chat, docs, or client code.

# Your Google AI Studio key (https://aistudio.google.com/apikey). Leave empty to run the
# mentor in offline mode with prepared answers.
GEMINI_API_KEY=

# PayPal SANDBOX app keys (developer.paypal.com → Apps & Credentials → Sandbox → your app).
# Test money only: the server only ever talks to api-m.sandbox.paypal.com. Leave empty and the
# PayPal pages show how to add them. Tick "Payouts" in the app's features for guardian payouts.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Payouts: each adult approves with their own PIN (at least 6 characters; make them different).
# A payout needs two of the three adults. Leave these empty and payouts stay switched off.
PAYOUT_PIN_MENTOR=
PAYOUT_PIN_ADMIN=
PAYOUT_PIN_GUARDIAN=
# The guardian's PayPal SANDBOX personal account email. Payouts always go here; the website
# can't change it.
GUARDIAN_PAYPAL_EMAIL=

# Where PayPal receipts, the reward pool and payout requests are saved (relative to server/).
# Delete the file to start fresh. It's git-ignored.
DATA_FILE=data/paypal-records.json

# Gemini model name (agreed: gemini-3.5-flash-lite: fast and cheap, good for short answers).
GEMINI_MODEL=gemini-3.5-flash-lite

# Where the server listens. The website's dev server proxies /api here.
API_PORT=8787
HOST=127.0.0.1

# Website addresses allowed to use the mentor from a browser, comma-separated. Other websites
# get 403. When deployed, set this to your real website address, e.g. https://sprout.vercel.app
ALLOWED_ORIGIN=http://127.0.0.1:5173,http://127.0.0.1:4173,http://localhost:5173,http://localhost:4173

# "true" only when deployed behind a host's proxy (Render, Railway, Fly), so rate limits see each
# user's real address. Keep "false" on your laptop so nobody can fake their address.
TRUST_PROXY=false

# Most mentor questions per hour from everyone together (protects your Gemini quota).
MENTOR_HOURLY_LIMIT=300

# The blockchain for the public impact ledger. Leave as is to use the local test chain that
# `npm run dev` starts (Hardhat, fake money, no wallet needed).
CHAIN_RPC_URL=http://127.0.0.1:8545

# Only for a real public chain later: a dedicated publisher wallet's key, typed in by hand.
# Leave empty locally. Never put a wallet that holds real money here.
PUBLISHER_PRIVATE_KEY=

# Guardian permission uses PAYOUT_PIN_GUARDIAN above, even without PayPal keys or a payee email.
# Set a unique guardian PIN, restart the API and record demo permission at /soon/safety.
# Sample learning reviews, garden and permission live separately from PayPal money records.
LEARNING_DATA_FILE=data/learning-records.json
